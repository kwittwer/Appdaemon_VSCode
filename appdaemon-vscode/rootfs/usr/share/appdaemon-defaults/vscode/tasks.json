{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Restart AppDaemon Add-on",
            "type": "shell",
            "command": "/config/.vscode/restart-addon.sh",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "isBackground": false
        },
        {
            "label": "Watch AppDaemon Logs",
            "type": "shell",
            "command": "tail",
            "args": [
                "-n",
                "200",
                "-f",
                "/config/logs/appdaemon.log"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": [],
            "isBackground": true
        }
    ]
}
