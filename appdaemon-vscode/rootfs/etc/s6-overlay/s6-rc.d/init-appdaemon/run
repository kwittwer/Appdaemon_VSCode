#!/command/with-contenv bashio
# ==============================================================================
# AppDaemon + VS Code add-on
# Prepares the AppDaemon configuration directory on first start
# ==============================================================================
declare log_level
declare -a python_packages
declare -a system_packages
declare -a init_commands

readonly CONFIG_DIR="/config"
readonly APPS_DIR="${CONFIG_DIR}/apps"
readonly DEFAULTS_DIR="/usr/share/appdaemon-defaults"

if [ -d "/logs" ] || [ ! -d "${CONFIG_DIR}" ]; then
    LOG_DIR="/logs"
else
    LOG_DIR="${CONFIG_DIR}/logs"
fi
readonly LOG_DIR

# ------------------------------------------------------------------------------
# Ensure the AppDaemon configuration structure exists
# ------------------------------------------------------------------------------
mkdir -p "${APPS_DIR}"
mkdir -p "${CONFIG_DIR}/dashboards"
mkdir -p "${LOG_DIR}"
chmod 755 "${LOG_DIR}" || true

# Seed the main configuration on first run
if ! bashio::fs.file_exists "${CONFIG_DIR}/appdaemon.yaml"; then
    bashio::log.info "No appdaemon.yaml found, creating a default one..."
    cp "${DEFAULTS_DIR}/appdaemon.yaml" "${CONFIG_DIR}/appdaemon.yaml"
fi

# Seed apps.yaml and example apps on first run
if ! bashio::fs.file_exists "${APPS_DIR}/apps.yaml"; then
    bashio::log.info "Seeding example AppDaemon apps..."
    cp "${DEFAULTS_DIR}/apps/apps.yaml" "${APPS_DIR}/apps.yaml"
    cp "${DEFAULTS_DIR}/apps/example_app.py" "${APPS_DIR}/example_app.py"
    cp "${DEFAULTS_DIR}/apps/debug_helper.py" "${APPS_DIR}/debug_helper.py"
fi

# Seed a VS Code debug configuration on first run
mkdir -p "${CONFIG_DIR}/.vscode"
if ! bashio::fs.file_exists "${CONFIG_DIR}/.vscode/launch.json"; then
    bashio::log.info "Seeding VS Code launch.json..."
    cp "${DEFAULTS_DIR}/vscode/launch.json" "${CONFIG_DIR}/.vscode/launch.json"
fi
if ! bashio::fs.file_exists "${CONFIG_DIR}/.vscode/tasks.json"; then
    bashio::log.info "Seeding VS Code tasks.json..."
    cp "${DEFAULTS_DIR}/vscode/tasks.json" "${CONFIG_DIR}/.vscode/tasks.json"
fi
if ! bashio::fs.file_exists "${CONFIG_DIR}/.vscode/restart-addon.sh"; then
    bashio::log.info "Seeding VS Code restart helper script..."
    cp "${DEFAULTS_DIR}/vscode/restart-addon.sh" "${CONFIG_DIR}/.vscode/restart-addon.sh"
    chmod +x "${CONFIG_DIR}/.vscode/restart-addon.sh"
fi
if ! bashio::fs.file_exists "${CONFIG_DIR}/.vscode/view-logs.sh"; then
    bashio::log.info "Seeding VS Code log viewer script..."
    cp "${DEFAULTS_DIR}/vscode/view-logs.sh" "${CONFIG_DIR}/.vscode/view-logs.sh"
    chmod +x "${CONFIG_DIR}/.vscode/view-logs.sh"
fi

# Ensure AppDaemon writes logs to the active log directory.
if grep -q '^[[:space:]]*log_dir:[[:space:]]*' "${CONFIG_DIR}/appdaemon.yaml"; then
    sed -i "s#^[[:space:]]*log_dir:[[:space:]]*.*#  log_dir: ${LOG_DIR}#" "${CONFIG_DIR}/appdaemon.yaml"
else
    bashio::log.info "Adding AppDaemon log_dir setting to appdaemon.yaml..."
    tmp_file="$(mktemp)"
    awk -v logdir="${LOG_DIR}" '
        /^[[:space:]]*appdaemon:[[:space:]]*$/ && added == 0 {
            print
            print "  log_dir: " logdir
            added = 1
            next
        }
        { print }
    ' "${CONFIG_DIR}/appdaemon.yaml" > "${tmp_file}" && mv "${tmp_file}" "${CONFIG_DIR}/appdaemon.yaml"
fi

if grep -q '^[[:space:]]*log_file:[[:space:]]*' "${CONFIG_DIR}/appdaemon.yaml"; then
    sed -i 's#^[[:space:]]*log_file:[[:space:]]*.*#  log_file: appdaemon.log#' "${CONFIG_DIR}/appdaemon.yaml"
else
    bashio::log.info "Adding AppDaemon log_file setting to appdaemon.yaml..."
    tmp_file="$(mktemp)"
    awk '
        /^[[:space:]]*log_dir:[[:space:]]*/ && added == 0 {
            print
            print "  log_file: appdaemon.log"
            added = 1
            next
        }
        { print }
    ' "${CONFIG_DIR}/appdaemon.yaml" > "${tmp_file}" && mv "${tmp_file}" "${CONFIG_DIR}/appdaemon.yaml"
fi

# Ensure MQTT plugin defaults are only configured when explicitly enabled.
mqtt_broker="$(bashio::config 'mqtt_broker')"
if [ -z "${mqtt_broker}" ] && grep -q '^[[:space:]]*MQTT:[[:space:]]*$' "${CONFIG_DIR}/appdaemon.yaml"; then
    bashio::log.info "Removing MQTT plugin from appdaemon.yaml (mqtt_broker not configured)..."
    tmp_file="$(mktemp)"
    awk '
        {
            if (drop == 1) {
                if ($0 ~ /^    [A-Za-z0-9_]+:[[:space:]]*$/ || $0 ~ /^[^ ]/) {
                    drop = 0
                } else {
                    next
                }
            }
            if (drop == 0 && $0 ~ /^    MQTT:[[:space:]]*$/) {
                drop = 1
                next
            }
            print
        }
    ' "${CONFIG_DIR}/appdaemon.yaml" > "${tmp_file}" && mv "${tmp_file}" "${CONFIG_DIR}/appdaemon.yaml"
elif [ -n "${mqtt_broker}" ] && ! grep -q '^[[:space:]]*MQTT:[[:space:]]*$' "${CONFIG_DIR}/appdaemon.yaml"; then
    if grep -q '^[[:space:]]*plugins:[[:space:]]*$' "${CONFIG_DIR}/appdaemon.yaml"; then
        mqtt_port="$(bashio::config 'mqtt_port')"
        mqtt_user="$(bashio::config 'mqtt_user')"
        mqtt_password="$(bashio::config 'mqtt_password')"

        bashio::log.info "Adding MQTT plugin defaults to appdaemon.yaml..."
        tmp_file="$(mktemp)"
        awk -v broker="${mqtt_broker}" -v port="${mqtt_port}" -v user="${mqtt_user}" -v pass="${mqtt_password}" '
            {
                print
            }
            /^[[:space:]]*plugins:[[:space:]]*$/ && added == 0 {
                b = broker
                u = user
                pw = pass
                gsub(/"/, "\\\"", b)
                gsub(/"/, "\\\"", u)
                gsub(/"/, "\\\"", pw)

                print "    MQTT:"
                print "      type: mqtt"
                print "      namespace: mqtt"
                print "      client_host: \"" b "\""
                print "      client_port: " port
                if (u != "") print "      client_user: \"" u "\""
                if (pw != "") print "      client_password: \"" pw "\""
                added = 1
            }
        ' "${CONFIG_DIR}/appdaemon.yaml" > "${tmp_file}" && mv "${tmp_file}" "${CONFIG_DIR}/appdaemon.yaml"
    else
        bashio::log.warning "Cannot add MQTT defaults: appdaemon.plugins section not found"
    fi
fi

# Migrate old debug adapter type in all workspace launch.json files.
while IFS= read -r launch_file; do
    if grep -q '"type"[[:space:]]*:[[:space:]]*"debugpy"' "${launch_file}"; then
        bashio::log.info "Updating debug type in ${launch_file} from debugpy to python..."
        sed -i 's/"type"[[:space:]]*:[[:space:]]*"debugpy"/"type": "python"/g' "${launch_file}"
    fi
done < <(find "${CONFIG_DIR}" -type f -path '*/.vscode/launch.json' 2>/dev/null)

# ------------------------------------------------------------------------------
# Optional: install extra system packages
# ------------------------------------------------------------------------------
if bashio::config.has_value 'system_packages'; then
    for package in $(bashio::config 'system_packages'); do
        system_packages+=("${package}")
    done
    bashio::log.info "Installing extra system packages: ${system_packages[*]}"
    apk add --no-cache "${system_packages[@]}" \
        || bashio::log.warning "Failed installing one or more system packages"
fi

# ------------------------------------------------------------------------------
# Optional: install extra Python packages
# ------------------------------------------------------------------------------
if bashio::config.has_value 'python_packages'; then
    for package in $(bashio::config 'python_packages'); do
        python_packages+=("${package}")
    done
    bashio::log.info "Installing extra Python packages: ${python_packages[*]}"
    pip install --no-cache-dir --break-system-packages "${python_packages[@]}" \
        || bashio::log.warning "Failed installing one or more Python packages"
fi

# ------------------------------------------------------------------------------
# Optional: run custom init commands
# ------------------------------------------------------------------------------
if bashio::config.has_value 'init_commands'; then
    while read -r cmd; do
        bashio::log.info "Running init command: ${cmd}"
        eval "${cmd}" || bashio::log.warning "Init command failed: ${cmd}"
    done <<< "$(bashio::config 'init_commands')"
fi

bashio::log.info "AppDaemon configuration is ready."
